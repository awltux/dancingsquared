node_modules/
dist/
dist-test/
.npm-cache/
# Playwright's browser download: ~180 MB, needed only for a real-browser check of the POC UI, and never a
# source artefact.
.pw-browsers/
*.local
# leftover diagnostic referencing the excluded dist-test build
poc/diag.cjs
# poc-matrix scratch / run artifacts (not source)
poc-matrix/_g.txt
poc-matrix/_ge.txt
poc-matrix/graph-progress.log
poc-matrix/analysis-progress.log
poc-matrix/getout-graph.json

# verify-suite run logs (tee'd so the run can be followed live; not source)
verify*.log
logs/

# CALLERLAB's Mainstream definitions, extracted from docs/*.pdf by
# test/tools/extract-pdf-text.mjs. Regenerated on demand, and not ours to redistribute by default.
callerlab-ms.txt

# PROBE SCRATCH: a `_` prefix means "not source" in `poc/tools`, which is also the convention
# `verify-probes.mjs` uses to skip `_*.mjs`. This covers the FSM view document `emit-fsm-view.mjs` writes
# for a real browser, the screenshots taken while checking the UI by hand, and any other one-off capture -
# all of it re-made on demand, and none of it input to a gate or to a build. The rule is the DIRECTORY-WIDE
# prefix rather than a line per artefact, because a line per artefact is how the next capture gets swept in
# by `git add -A`: three screenshots (195 + 94 + 64 KB) had been committed that way, which is what this
# restores.
poc/tools/_*

# A probe's stdout captured to a file so it can be read (PowerShell's `>` writes UTF-16, which the
# read tool refuses, so these are re-captured through Out-File -Encoding utf8). Never source.
engine/test/tools/_*.txt
/docs/downloads/*

# AN ORIENTATION DOCUMENT IS NOT STATE. Three HANDOVER.md files have now been deleted, the last one at
# 7484cdb and this line with it: AGENTS.md §8 records the measured failure mode, that a document regenerated
# only when a session ends is read as current state by the session after it. The authorities are PLAN.md §2
# and game/DESIGN.md §11.1, and both are corrected in the same commit as the code they describe. Ignoring
# the name rather than trusting the next session to delete it is the point: a handover is now not stageable.
HANDOVER.md
