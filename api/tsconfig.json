{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // NO DOM LIB, DELIBERATELY. This package runs on Node and must not acquire a habit the browser cannot
    // pay for: `src/ports.ts` hands a handler a plain request object precisely so nothing here reaches for
    // `fetch`, `window` or a `Headers`. The probes are `.mjs` and are not typechecked, so they may use the
    // globals Node has (the end-to-end probe drives a real socket with `fetch`).
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    // THE PROBES LOAD THIS SOURCE DIRECTLY under Node's type stripping, which CONSTRAINS THE SOURCE in two ways
    // the compiler will not tell you about. Relative specifiers carry `.ts`, because Node's loader does not map
    // `./x.js` onto `x.ts` — a `.js` specifier typechecks and then fails to resolve at runtime. And there are
    // NO CONSTRUCTOR PARAMETER PROPERTIES: strip-only mode refuses the syntax outright
    // (`ERR_UNSUPPORTED_TYPESCRIPT_SYNTAX: TypeScript parameter property is not supported in strip-only mode`)
    // while `tsc --noEmit` is perfectly happy, so the failure appears the first time a probe imports the file.
    // MEASURED in `src/store/dynamo.ts`, where the class had to be rewritten with explicit fields.
    "allowImportingTsExtensions": true
  },
  "include": ["src"]
}
