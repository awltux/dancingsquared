<tamination title="Switch the Wave">

  <tam title="Switch the Wave" from="Right-Hand Wave"
       formation="Wave RH Boys Center" vid="V1-fj6mhtz1">
    <path numbers="2 3" couples="3 1">
      <move select="Run Right" beats="6"/>
    </path>
    <path numbers="1 4" couples="1 3">
      <move select="Run Right" beats="6" scaleY="2" />
    </path>
  </tam>

  <tam title="Switch the Wave" from="Compact Right-Hand Wave"
       formation="Compact Wave RH" display="none" vid="V1-pmashbbc">
    <path>
      <move select="Run Right" beats="6" />
    </path>
    <path>
      <move select="Run Right" beats="6" scaleX=".5" scaleY=".5"/>
    </path>
  </tam>

  <tam title="Switch the Wave" from="Left-Hand Wave" formation="Wave LH" vid="V1-f2e400u2">
    <path numbers="4 1" couples="3 1">
      <move select="Run Left" beats="6" scaleY="2" />
    </path>
    <path numbers="3 2" couples="3 1">
      <move select="Run Left" beats="6"/>
    </path>
  </tam>

  <tam title="Switch the Wave" from="Compact Left-Hand Wave"
       formation="Compact Wave LH" display="none" vid="V1-buno9i63">
    <path>
      <move select="Run Left" beats="6"/>
    </path>
    <path>
      <move select="Run Left" beats="6" scaleX=".5" scaleY=".5"/>
    </path>
  </tam>

  <tam title="Switch the Wave"
       from="Right-Hand Waves"
       formation="Ocean Waves RH GBBG" vid="V1-p4n67vsv">
