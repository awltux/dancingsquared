<tamination title="Vertical Tag">

  <tam title="Vertical Tag"
       from="Facing Couples"
       formation="Facing Couples" vid="V1-7yknope4">
    <path couples="3 1">
      <move select="Stand" beats="2" />
      <move select="Forward" />
      <move select="Extend Right" beats="2" scaleX="2" />
    </path>
    <path couples="3 1">
      <move select="Extend Left" beats="2" scaleX="2" scaleY="1.5" />
      <move select="Extend Right" beats="3" scaleX="3" scaleY=".5" />
    </path>
  </tam>

  <tam title="Vertical Tag"
       from="Couples Facing Out" vid="V1-obi1osq7">
    <formation fid="F3-ik8242br" aid="A1-27lc8wm5">
      <dancer gender="girl" x="1" y="2" angle="90"/>
      <dancer gender="boy" x="-1" y="2" angle="90"/>
    </formation>
    <path numbers="3 2">
      <move select="U-Turn Left" offsetX="-1.5" offsetY=".5"/>
      <move select="Forward" />
      <move select="Extend Right" beats="2.5" scaleX="2.5" scaleY=".5" />
    </path>
    <path numbers="1 4">
      <move select="Flip Right" offsetX=".5" offsetY=".5" />
      <move select="Forward 2" />
      <move select="Extend Right" beats="1.5" scaleX="1.5" scaleY=".5" />
    </path>
  </tam>

  <tam title="Vertical Tag"
       from="Right-Hand Box"
       formation="Box RH" vid="V1-o1kyx2ib">
    <path>
      <move select="Forward 2" beats="3" />
      <move select="Extend Right" beats="3" scaleX="3" />
    </path>
    <path>
      <move select="Flip Right" />
      <move select="Forward" />
      <move select="Extend Right" beats="2" scaleX="2" />
    </path>
  </tam>

  <tam title="Vertical Tag"
       from="Left-Hand Box" vid="V1-dq4fl69v">
    <formation fid="F3-0pwss2ox" aid="A1-m4dsj3np">
      <dancer gender="boy" x="1" y="2" angle="90"/>
      <dancer gender="girl" x="-1" y="2" angle="270"/>
    </formation>
    <path numbers="3 2">
      <move select="U-Turn Left" beats="2" offsetY=".5"/>
      <move select="Forward 2"/>
      <move select="Extend Right" scaleY=".5"/>
    </path>
    <path numbers="1 4">
      <move select="Extend Left" beats="2" scaleX="2" scaleY="1.5"/>
      <move select="Forward 2"/>
      <move select="Extend Right" scaleY=".5"/>
    </path>
    <taminator>Note that the dancers pass right shoulders.
    </taminator>
  </tam>

  <tam title="Vertical 1/4 Tag" from="Facing Couples" formation="Facing Couples" vid="V1-vjxwkhd4">
    <path couples="3 1">
      <move select="Dodge Right" scaleY=".5"/>
    </path>
    <path couples="3 1">
      <move select="Extend Left" beats="3" scaleX="2" scaleY="2"/>
    </path>
  </tam>

  <tam title="Vertical 1/4 Tag" from="Couples Facing Out" formation="Couples Facing Out" vid="V1-qpfpwp2z">
    <path>
      <move select="U-Turn Left" offsetX="-1"/>
      <move select="Forward"/>
    </path>
    <path>
      <move select="Flip Right" scaleY=".5"/>
    </path>
  </tam>

  <tam title="Vertical 1/4 Tag" from="Right-Hand Box" formation="Box RH" vid="V1-j7fmh53z">
    <path>
      <move select="Forward 2" beats="3"/>
    </path>
    <path>
      <move select="Flip Right" scaleY=".5"/>
    </path>
  </tam>

  <tam title="Vertical 1/4 Tag" from="Left-Hand Box" formation="Box LH" vid="V1-9i2r1nzr">
    <path>
      <move select="Flip Left" scaleY=".5"/>
    </path>
    <path>
      <move select="Extend Left" beats="3" scaleX="2" scaleY="2"/>
    </path>
  </tam>

  <tam title="Vertical 1/2 Tag"
       from="Facing Couples" vid="V1-0js8s1qr">
    <formation fid="F3-4ro3p815" aid="A1-yl2mr1qt">
      <dancer gender="boy" x="1" y="1.5" angle="270"/>
      <dancer gender="girl" x="-1" y="1.5" angle="270"/>
    </formation>
    <path numbers="3 2">
      <move select="Dodge Right" beats="2" scaleY=".25"/>
      <move select="Dodge Left" beats="2" scaleY=".25"/>
    </path>
    <path numbers="1 4">
      <move select="Extend Left" beats="2" scaleX="1.5" scaleY="1.5" />
      <move select="Extend Left" beats="2" scaleX="1.5" scaleY=".5"/>
    </path>
    <taminator>Compare this with Belles Cross.</taminator>
  </tam>

  <tam title="Vertical 1/2 Tag" from="Couples Facing Out" formation="Couples Facing Out" vid="V1-miodxtqx">
    <path>
      <move select="U-Turn Left" offsetX="-2"/>
      <move select="Forward 2"/>
    </path>
    <path>
      <move select="Flip Right"/>
    </path>
  </tam>

  <tam title="Vertical 1/2 Tag" from="Right-Hand Box" formation="Box RH" vid="V1-k4frgyv9">
    <path>
      <move select="Forward 4" beats="3"/>
    </path>
    <path>
      <move select="Flip Right"/>
    </path>
    <taminator>Compare with Box Circulate</taminator>
  </tam>

  <tam title="Vertical 1/2 Tag"
       from="Left-Hand Box" vid="V1-ndlxwea5">
    <formation fid="F3-0pwss2ox" aid="A1-m4dsj3np">
      <dancer gender="boy" x="1" y="2" angle="90"/>
      <dancer gender="girl" x="-1" y="2" angle="270"/>
    </formation>
    <path numbers="3 2">
      <move select="U-Turn Left" beats="2" offsetY=".5"/>
      <move select="Dodge Left" beats="2" scaleY=".25"/>
    </path>
    <path numbers="1 4">
      <move select="Extend Left" beats="2" scaleX="2" scaleY="1.5"/>
      <move select="Extend Left" beats="2" scaleX="2" scaleY=".5"/>
    </path>
  </tam>

  <tam title="Vertical 3/4 Tag" from="Facing Couples" formation="Facing Couples" vid="V1-vszhrk1y">
    <path couples="3 1">
      <move select="Stand" beats="2"/>
      <move select="Forward 2"/>
    </path>
    <path couples="3 1">
      <move select="Extend Left" beats="2" scaleX="2" scaleY="1.5"/>
      <move select="Extend Right" beats="2" scaleX="2" scaleY=".5"/>
    </path>
  </tam>

  <tam title="Vertical 3/4 Tag" from="Couples Facing Out" formation="Couples Facing Out" vid="V1-1a47noo9">
    <path>
      <move select="U-Turn Left" offsetX="-2"/>
      <move select="Extend Right" beats="2" scaleX="2"/>
    </path>
    <path>
      <move select="Flip Right"/>
      <move select="Forward 2"/>
    </path>
  </tam>

  <tam title="Vertical 3/4 Tag" from="Right-Hand Box" formation="Box RH" vid="V1-rga572ut">
    <path>
      <move select="Forward 2"/>
      <move select="Extend Right" beats="2" scaleX="2"/>
    </path>
    <path>
      <move select="Flip Right" offsetX="-1"/>
      <move select="Forward"/>
    </path>
  </tam>

  <tam title="Vertical 3/4 Tag" from="Left-Hand Box" formation="Box LH" vid="V1-yg9vagm5">
    <path>
      <move select="U-Turn Left" beats="2" offsetY=".5"/>
      <move select="Extend Left" beats="2" scaleX="2" scaleY=".5"/>
    </path>
    <path>
      <move select="Extend Left" beats="2" scaleX="2" scaleY="1.5"/>
      <move select="Forward"/>
      <move select="Extend Right" scaleY=".5"/>
    </path>
  </tam>

  <tam title="All 8 Vertical 1/2 Tag" formation="Static Square" group=" " vid="V1-c8xbiuic">
    <path>
    </path>
    <path>
      <move select="Extend Left" beats="3" scaleX="3" scaleY="2" />
      <move select="Forward 3"/>
    </path>
    <path>
    </path>
    <path>
      <move select="Extend Left" beats="3" scaleX="3" scaleY="2" />
      <move select="Forward 3"/>
    </path>
  </tam>

</tamination>
