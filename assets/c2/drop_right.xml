<tamination title="Drop Right/Left">



  <tam title="Drop Right"
       from="Right-Hand Diamond"
       formation="Diamond RH" vid="V1-etmvombf">
    <path>
      <move select="Lead Right" beats="2" />
    </path>
    <path>
      <move select="Forward 2" />
    </path>
  </tam>

  <tam title="Drop Right" from="Left-Hand Diamond" formation="Diamond LH" vid="V1-40w624ei">
    <path>
      <move select="Quarter Right" beats="2" offsetX="1" offsetY="1" />
    </path>
    <path>
      <move select="Forward 2" />
    </path>
  </tam>

  <tam title="Drop Left" from="Right-Hand Diamond" formation="Diamond RH" vid="V1-wxq29lqm">
    <path>
      <move select="Quarter Left" beats="2" offsetX="1" offsetY="-1" />
    </path>
    <path>
      <move select="Forward 2" />
    </path>
  </tam>

  <tam title="Drop Left" from="Left-Hand Diamond" formation="Diamond LH" vid="V1-289so1or">
    <path>
      <move select="Lead Left" beats="2" />
    </path>
    <path>
      <move select="Forward 2" />
    </path>
  </tam>

  <tamxref title="Grand Drop Right" group=" "
           xref-link="c2/drop_in"
           xref-title="Grand Drop In"/>

  <tamxref title="Grand Drop Left" group=" "
           xref-link="c2/drop_in"
           xref-title="Grand Drop Out"/>

</tamination>
