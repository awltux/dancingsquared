{
  "name": "dancing-squared-engine",
  "version": "0.1.0",
  "description": "Standalone square-dance engine: parses taminations XML into a normalized call bundle and evaluates dancer poses, facing, and hand holds. Renderer-agnostic.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/entries/core.d.ts",
      "import": "./dist/entries/core.js"
    },
    "./document": {
      "types": "./dist/entries/document.d.ts",
      "import": "./dist/entries/document.js"
    },
    "./ids": {
      "types": "./dist/entries/ids.d.ts",
      "import": "./dist/entries/ids.js"
    },
    "./authoring": {
      "types": "./dist/entries/authoring.d.ts",
      "import": "./dist/entries/authoring.js"
    },
    "./sequencer": {
      "types": "./dist/entries/sequencer.d.ts",
      "import": "./dist/entries/sequencer.js"
    },
    "./all8": {
      "types": "./dist/entries/all8.d.ts",
      "import": "./dist/entries/all8.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "verify": "tsc -p tsconfig.json && node test/verify-suite.mjs all",
    "verify:light": "tsc -p tsconfig.json && node test/verify-suite.mjs light",
    "verify:figures": "tsc -p tsconfig.json && node test/verify-suite.mjs figures"
  },
  "keywords": [
    "square-dance",
    "taminations",
    "dance",
    "animation",
    "engine"
  ],
  "license": "AGPL-3.0",
  "devDependencies": {
    "@xmldom/xmldom": "^0.9.11",
    "dancing-squared-corpus": "file:../packages/corpus",
    "typescript": "^5.6.0"
  }
}
