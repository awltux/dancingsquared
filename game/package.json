{
  "name": "dancing-squared-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The call game: a pure, seeded puzzle core (levels, generator, session) over dancing-squared-engine, plus the Drill UI. No network yet.",
  "exports": {
    ".": {
      "types": "./src/puzzle/index.ts",
      "import": "./src/puzzle/index.ts"
    },
    "./corpus-node": {
      "types": "./src/data/corpus-node.ts",
      "import": "./src/data/corpus-node.ts"
    },
    "./schedule-fixture": {
      "types": "./src/game/schedule-fixture.ts",
      "import": "./src/game/schedule-fixture.ts"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "verify": "node tools/verify-probes.mjs",
    "measure": "node tools/measure-ladder.mjs"
  },
  "dependencies": {
    "dancing-squared-corpus": "file:../packages/corpus",
    "dancing-squared-engine": "file:../engine",
    "dancing-squared-stage": "file:../packages/stage",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/three": "^0.169.0",
    "@xmldom/xmldom": "^0.9.11",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
