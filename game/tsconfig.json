{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // DOM AND vite/client ARE FOR THE APP ONLY. `src/puzzle/**` imports neither - it is the pure core -
    // but one tsconfig covers the package, and the alternative (a second tsconfig per layer) buys nothing
    // when the probes only ever import the core and `src/game/`. `vite/client` is what types
    // `import.meta.glob` and `?raw`, which live in `src/data/assets.ts` and nowhere else.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // NODE IS FOR ONE FILE: `src/data/corpus-node.ts`, the Node-only loader that the game's probes and the
    // API share (`fs`, `node:url`). It is in no browser import graph — `src/data/corpus.ts` is the app's seam
    // and reads the same bytes through Vite — so the app is unaffected, and the alternative (a `.mjs` loader
    // outside the typecheck) is what this file already was before Phase 5 gave it a second consumer.
    "types": ["vite/client", "node"],
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "useDefineForClassFields": true,
    "noEmit": true,
    // THE PROBES LOAD THIS SOURCE DIRECTLY, under Node's type stripping, so relative specifiers carry
    // `.ts` — Node's loader does NOT map `./x.js` onto `x.ts`, and a `.js` specifier therefore fails to
    // resolve at runtime while type-checking perfectly. `poc/src/fsm-view.ts` establishes the same
    // convention for the same reason (`poc/tools/fsm-open-probe.mjs` loads it by path). Legal only
    // because nothing here ever emits.
    "allowImportingTsExtensions": true
  },
  "include": ["src"]
}
