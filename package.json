{
  "name": "dancing-squared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Square-dance engine + 3D PoC (npm workspaces monorepo)",
  "workspaces": [
    "engine",
    "packages/stage",
    "packages/corpus",
    "game",
    "api",
    "poc",
    "poc-teacher",
    "poc-matrix"
  ],
  "scripts": {
    "build:engine": "npm run build -w dancing-squared-engine",
    "build": "npm run build -w dancing-squared-engine && npm run build -w dancing-squared-poc",
    "dev": "npm run dev -w dancing-squared-poc",
    "preview": "npm run preview -w dancing-squared-poc",
    "dev:teacher": "npm run dev -w dancing-squared-teacher",
    "build:teacher": "npm run build -w dancing-squared-teacher",
    "verify:teacher": "npm run verify -w dancing-squared-teacher",
    "verify": "npm run build -w dancing-squared-engine && npm run verify -w dancing-squared-poc",
    "verify:engine": "npm run verify -w dancing-squared-engine",
    "verify:game": "npm run verify -w dancing-squared-game",
    "dev:game": "npm run dev -w dancing-squared-game",
    "dev:api": "npm run dev -w dancing-squared-api",
    "dev:api:ddb": "npm run dev:ddb -w dancing-squared-api",
    "api:table": "node api/tools/create-table.mjs",
    "api:publish-daily": "npm run publish-daily -w dancing-squared-api --",
    "api:publish-schedule": "npm run publish-schedule -w dancing-squared-api --",
    "verify:api": "npm run verify -w dancing-squared-api",
    "verify:api:ddb": "node api/tools/verify-probes.mjs --require-ddb",
    "build:game": "npm run build -w dancing-squared-game",
    "preview:game": "npm run preview -w dancing-squared-game",
    "measure:ladder": "npm run measure -w dancing-squared-game",
    "build:book": "node book/tools/make-animations.mjs && node book/tools/make-formations.mjs && node book/tools/make-diagrams.mjs && node book/tools/make-reference.mjs && node book/tools/make-nav.mjs && node book/tools/build-site.mjs",
    "build:book:anims": "node book/tools/make-animations.mjs",
    "build:book:gifs": "node book/tools/make-animations.mjs --gifs",
    "build:book:site": "node book/tools/build-site.mjs",
    "serve:book": "node book/tools/serve-site.mjs",
    "check:book": "node book/tools/check-links.mjs && node book/tools/make-animations.mjs --check && node book/tools/make-animations.mjs --verify && node book/tools/make-diagrams.mjs --check",
    "deploy:book": "node scripts/deploy-book.mjs"
  }
}
