<tamination title="Half Sashay Family">

  <tam title="Half Sashay" from="Facing Couples" formation="Facing Couples">
    <path>
      <move select="BackSashay Right" beats="4" />
    </path>
    <path>
      <move select="Sashay Left" beats="4" />
    </path>
  </tam>

  <tam title="Half Sashay" from="Lines" formation="Normal Lines">
    <path>
      <move select="BackSashay Right" beats="4" />
    </path>
    <path>
      <move select="Sashay Left" beats="4" />
    </path>
    <path>
      <move select="BackSashay Right" beats="4" />
    </path>
    <path>
      <move select="Sashay Left" beats="4" />
    </path>
  </tam>

  <tam title="Half Sashay" from="Squared Set" formation="Static Square">
    <path>
      <move select="BackSashay Right" beats="4" />
    </path>
    <path>
      <move select="Sashay Left" beats="4" />
    </path>
    <path>
      <move select="BackSashay Right" beats="4" />
    </path>
    <path>
      <move select="Sashay Left" beats="4" />
    </path>
  </tam>

  <tam title="Heads Half Sashay" from="Squared Set" formation="Static Square" display="none">
    <path>
      <move select="BackSashay Right" beats="4" />
    </path>
    <path>
      <move select="Sashay Left" beats="4" />
    </path>
    <path/>
    <path/>
  </tam>

  <tam title="Sides Half Sashay" from="Squared Set" formation="Static Square" display="none">
    <path/>
    <path/>
    <path>
      <move select="BackSashay Right" beats="4" />
    </path>
    <path>
      <move select="Sashay Left" beats="4" />
    </path>
  </tam>

  <tam title="Ladies In, Men Sashay"
       from="Circle Left"
       formation="Circle" sequencer="gender-specific">
    <path>
      <move select="Sxtnth Left" />
      <move select="cl" beats="2" />
      <move select="cl" beats="2" />
      <move select="Sxtnth Right" />
    </path>
    <path>
      <move select="Forward" beats="2" scaleX="1.5" />
      <move select="Back" beats="2" scaleX="1.5" />
    </path>
    <path>
      <move select="Sxtnth Left" />
      <move select="cl" beats="2" />
      <move select="cl" beats="2" />
      <move select="Sxtnth Right" />
    </path>
    <path>
      <move select="Forward" beats="2" scaleX="1.5" />
      <move select="Back" beats="2" scaleX="1.5" />
    </path>
  </tam>

  <tam title="Ladies In, Men Sashay"
       from="Circle Right" sequencer="gender-specific"
       formation="Circle">
    <path>
      <move select="Sxtnth Right" />
      <move select="cr" beats="2" />
      <move select="cr" beats="2" />
      <move select="Sxtnth Left" />
    </path>
    <path>
      <move select="Forward" beats="2" scaleX="1.5" />
      <move select="Back" beats="2" scaleX="1.5" />
    </path>
    <path>
      <move select="Sxtnth Right" />
      <move select="cr" beats="2" />
      <move select="cr" beats="2" />
      <move select="Sxtnth Left" />
    </path>
    <path>
      <move select="Forward" beats="2" scaleX="1.5" />
      <move select="Back" beats="2" scaleX="1.5" />
    </path>
  </tam>

  <tam title="Rollaway" from="Facing Couples" formation="Facing Couples">
    <path>
      <move select="Dodge Right" hands="gripright" />
    </path>
    <path>
      <move select="Fold Left" hands="gripleft" beats="1.5" scaleX=".6" scaleY=".5" />
      <move select="U-Turn Left" hands="gripleft" beats="1.5" offsetX="1.2" offsetY="-1" />
    </path>
  </tam>

  <tam title="Rollaway" from="Couples Facing Out" formation="Couples Facing Out">
    <path>
      <move select="Fold Left" hands="gripleft" beats="1.5" scaleX=".6" scaleY=".5" />
      <move select="U-Turn Left" hands="gripleft" beats="1.5" offsetX="1.2" offsetY="-1" />
    </path>
    <path>
      <move select="Dodge Right" hands="gripright" />
    </path>
  </tam>

  <!-- SEPARATION TWO, and it is the only difference. `Rollaway` is a per-couple HALF SASHAY: the two
       dancers of a couple exchange places, so the displacement is the couple's own width (2) and does
       NOT depend on how far two couples stand apart. The authoring above places the couples FOUR
       apart (`Facing Couples`), and the corpus reaches the call from boards whose couples stand TWO
       apart - an `Eight Chain Thru` or a `Quarter Tag`, four couples in parallel columns - so every
       one of those refused with "no setup in this call matches the current formation". Measured
       (test/tools probe, then the census): at separation 4 the authoring ends with each couple's two
       dancers exactly swapped, facings unchanged; the paths are in each dancer's OWN frame and their
       offsets do not depend on the couple separation, so the same paths at separation 2 give the same
       swap. The start formation is written INLINE at x = -1 so the engine's own mirror (180 degrees
       about the origin) places the second couple at x = +1. This is the same missing-separation class
       as `Box the Gnat`, `Pass Thru` and `Right Pull By`, and the fourth instance of it. -->
  <tam title="Rollaway" from="Facing Couples">
    <formation>
      <dancer gender="boy" x="-1" y="1" angle="0" />
      <dancer gender="girl" x="-1" y="-1" angle="0" />
    </formation>
    <path>
      <move select="Dodge Right" hands="gripright" />
    </path>
    <path>
      <move select="Fold Left" hands="gripleft" beats="1.5" scaleX=".6" scaleY=".5" />
      <move select="U-Turn Left" hands="gripleft" beats="1.5" offsetX="1.2" offsetY="-1" />
    </path>
  </tam>

  <tam title="Rollaway"
       from="Lines"
       formation="Normal Lines">
    <path>
      <move select="Dodge Right" hands="gripright" />
    </path>
    <path>
      <move select="Fold Left" hands="gripleft" beats="1.5" scaleX=".6" scaleY=".5" />
      <move select="U-Turn Left" hands="gripleft" beats="1.5" offsetX="1.2" offsetY="-1" />
    </path>
    <path>
      <move select="Dodge Right" hands="gripright" />
    </path>
    <path>
      <move select="Fold Left" hands="gripleft" beats="1.5" scaleX=".6" scaleY=".5" />
      <move select="U-Turn Left" hands="gripleft" beats="1.5" offsetX="1.2" offsetY="-1" />
    </path>
  </tam>

  <tam title="Rollaway" from="Circle Left" formation="Circle" sequencer="gender-specific">
    <path>
      <move select="Stand" hands="gripright" beats="4.5"/>
      <move select="Stand" hands="both" beats=".1"/>
    </path>
    <path>
      <move select="Eighth Left" hands="gripleft" offsetX=".5" offsetY=".1"/>
      <move select="Quarter Left" hands="gripleft" offsetX="1.4"/>
      <move select="Quarter Left" hands="gripleft" offsetY="-1.4"/>
      <move select="Eighth Left" hands="gripleft" offsetX="-.4" offsetY="-.25"/>
      <move select="Stand" hands="both" beats=".1"/>
    </path>
    <path>
      <move select="Stand" hands="gripright" beats="4.5"/>
      <move select="Stand" hands="both" beats=".1"/>
    </path>
    <path>
      <move select="Eighth Left" hands="gripleft" offsetX=".5" offsetY=".1"/>
      <move select="Quarter Left" hands="gripleft" offsetX="1.4"/>
      <move select="Quarter Left" hands="gripleft" offsetY="-1.4"/>
      <move select="Eighth Left" hands="gripleft" offsetX="-.4" offsetY="-.25"/>
      <move select="Stand" hands="both" beats=".1"/>
    </path>
  </tam>


</tamination>
