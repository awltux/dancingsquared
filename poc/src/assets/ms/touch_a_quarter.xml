<tamination title="Touch a Quarter">

  <tam title="Touch a Quarter"
       from="Facing Couples"
       formation="Facing Couples Compact"
       difficulty="1">
    <path>
      <move select="Extend Left" scaleX="1.5" />
      <move select="Hinge Right" beats="1" scaleY=".5"/>
    </path>
    <path>
      <move select="Extend Left" scaleX="1.5" scaleY=".5" />
      <move select="Hinge Right" beats="1" />
    </path>
  </tam>

  <!-- SEPARATION SIX. The authorings above are for couples THREE (Facing Couples Compact) and FOUR
       (Facing Couples, b2) apart; the heads of a Static Square are two couples facing each other
       SIX apart, so `Heads Touch 1/4` - one of the first-call failures - matched neither. The law is
       the one every separation fix in this catalogue has used and the two authorings pin it:
       `scaleX = separation / 2`, so separation 6 gives `scaleX = 3`. Everything else is unchanged,
       and the start formation is written INLINE at x = -3 so the engine's own mirror (180 degrees
       about the origin) puts the second couple at x = +3.

       The `Hinge Right` is NOT scaled: it is the quarter turn taken in place at the end of the
       extension, so it does not depend on how far the dancers travelled to get there. -->
  <tam title="Touch a Quarter"
       from="Facing Couples"
       difficulty="1">
    <formation>
      <dancer gender="boy" x="-3" y="1" angle="0" />
      <dancer gender="girl" x="-3" y="-1" angle="0" />
    </formation>
    <path>
      <move select="Extend Left" scaleX="3" />
      <move select="Hinge Right" beats="1" scaleY=".5"/>
    </path>
    <path>
      <move select="Extend Left" scaleX="3" scaleY=".5" />
      <move select="Hinge Right" beats="1" />
    </path>
  </tam>

  <tam title="Touch a Quarter"
       from="Lines"
       formation="Normal Lines"
       difficulty="1">
    <path>
      <move select="Extend Left" scaleX="2" scaleY=".5" />
      <move select="Hinge Right" scaleY=".5" beats="1" hands="gripright"/>
    </path>
    <path>
      <move select="Extend Left" scaleX="2" scaleY=".5" />
      <move select="Hinge Right" scaleY=".5" beats="1" hands="gripright"/>
    </path>
    <path>
      <move select="Extend Left" scaleX="2" scaleY=".5" />
      <move select="Hinge Right" scaleY=".5" beats="1" hands="gripright"/>
    </path>
    <path>
      <move select="Extend Left" scaleX="2" scaleY=".5" />
      <move select="Hinge Right" scaleY=".5" beats="1" hands="gripright"/>
    </path>
  </tam>

  <tam title="Touch a Quarter"
       from="Eight Chain Thru"
       formation="Eight Chain Thru"
       difficulty="1">
    <path>
      <move select="Extend Left" />
      <move select="Quarter Right" hands="right" offsetX="1" />
    </path>
    <path>
      <move select="Forward" />
      <move select="Hinge Right" />
    </path>
    <path>
      <move select="Extend Left" />
      <move select="Quarter Right" hands="right" offsetX="1" />
    </path>
    <path>
      <move select="Forward" />
      <move select="Hinge Right" />
    </path>
  </tam>

  <tam title="Left Touch a Quarter"
       from="Facing Couples"
       formation="Facing Couples Compact"
       difficulty="2" sequencer="no">
    <path>
      <move select="Extend Right" scaleX="1.5" scaleY=".5" />
      <move select="Hinge Left" beats="1" />
    </path>
    <path>
      <move select="Extend Right" scaleX="1.5" />
      <move select="Hinge Left" beats="1" scaleY=".5"/>
    </path>
  </tam>

  <tam title="Left Touch a Quarter"
       from="Lines"
       formation="Normal Lines"
       difficulty="2">
    <path>
      <move select="Extend Right" scaleX="2" scaleY=".5" />
      <move select="Hinge Left" scaleY=".5" beats="1" hands="gripleft"/>
    </path>
    <path>
      <move select="Extend Right" scaleX="2" scaleY=".5" />
      <move select="Hinge Left" scaleY=".5" beats="1" hands="gripleft"/>
    </path>
    <path>
      <move select="Extend Right" scaleX="2" scaleY=".5" />
      <move select="Hinge Left" scaleY=".5" beats="1" hands="gripleft"/>
    </path>
    <path>
      <move select="Extend Right" scaleX="2" scaleY=".5" />
      <move select="Hinge Left" scaleY=".5" beats="1" hands="gripleft"/>
    </path>
  </tam>

  <tam title="Left Touch a Quarter"
       from="Eight Chain Thru"
       formation="Eight Chain Thru"
       difficulty="2">
    <path>
      <move select="Forward" />
      <move select="Hinge Left" />
    </path>
    <path>
      <move select="Extend Right" />
      <move select="Quarter Left" hands="left" offsetX="1" />
    </path>
    <path>
      <move select="Forward" />
      <move select="Hinge Left" />
    </path>
    <path>
      <move select="Extend Right" />
      <move select="Quarter Left" hands="left" offsetX="1" />
    </path>
  </tam>

  <tam title="Touch a Half"
       from="Facing Couples"
       formation="Facing Couples Compact"
       difficulty="2">
    <path>
      <move select="Extend Left" beats="3" scaleX="1.5" scaleY="2" />
      <move select="Swing Right" />
    </path>
    <path>
      <move select="Forward" beats="3" scaleX="1.5"/>
      <move select="Swing Right" />
    </path>
  </tam>
</tamination>
